# Server-only variables used by the /api functions.
# Add them in Vercel -> Project Settings -> Environment Variables (and in .env for `vercel dev`).

# Resend (https://resend.com) sends the contact-form email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Upstash Redis (https://upstash.com) stores ratings and rate-limit counters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any long random string. Used to hash visitor IPs before they are stored.
IP_HASH_SALT=
